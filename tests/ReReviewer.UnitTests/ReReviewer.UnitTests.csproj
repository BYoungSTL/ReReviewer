<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Тестовые проекты xUnit v3 — исполняемые файлы. -->
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- xUnit1051 просит передавать TestContext.Current.CancellationToken в каждый вызов — для этих тестов это шум. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
        <Using Include="NSubstitute" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="NSubstitute" Version="6.2.0" />
      <PackageReference Include="Shouldly" Version="4.3.0" />
      <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="xunit.v3" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ReReviewer.Application\ReReviewer.Application.csproj" />
      <ProjectReference Include="..\..\ReReviewer.Server\ReReviewer.Server.csproj" />
      <ProjectReference Include="..\..\ReReviewer.Data\ReReviewer.Data.csproj" />
    </ItemGroup>

</Project>
