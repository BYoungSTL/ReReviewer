# Скопируйте в .env (он в .gitignore) и заполните. docker compose подхватывает .env автоматически.

# Пароль пользователя sa в контейнере SQL Server. Требования SQL Server: не короче 8 символов,
# минимум три вида символов из четырёх (строчные, заглавные, цифры, спецсимволы).
# Не используйте ; и " — пароль подставляется в строку подключения.
MSSQL_SA_PASSWORD=

# Ключ подписи JWT, не короче 32 символов. Сгенерировать в PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=

# Необязательно: порт API на компьютере (по умолчанию 8080) и окружение (по умолчанию Development,
# только в нём доступны /openapi/v1.json и /scalar).
# API_PORT=8080
# ASPNETCORE_ENVIRONMENT=Development
