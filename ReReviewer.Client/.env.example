# Скопируйте в .env.local (он в .gitignore) и поменяйте, если нужно. Без файла действуют значения ниже.

# Адрес ReReviewer API. К нему обращается только сервер Next.js, браузер ходит через /api/* этого сайта.
# По умолчанию — профиль http из ReReviewer.Server/Properties/launchSettings.json.
API_URL=http://localhost:5070

# Публичный адрес сайта: из него строятся абсолютные ссылки в метатегах Open Graph.
SITE_URL=http://localhost:3000
