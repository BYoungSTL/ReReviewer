{
  "name": "rereviewer-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:5070/openapi/v1.json -o src/lib/api/schema.d.ts --properties-required-by-default --root-types --root-types-no-schema-prefix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1",
      "onFail": "warn"
    }
  }
}
